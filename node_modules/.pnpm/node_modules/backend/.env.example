# Servidor
PORT=3000
NODE_ENV=development

# Base de Datos (SQL Server)
DB_HOST=tu_servidor_sql_server
DB_PORT=1433
DB_USER=tu_usuario_db
DB_PASSWORD=tu_contrasena_db
DB_NAME=nombre_base_datos
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Autenticación
JWT_SECRET=tu_jwt_secret_largo_y_seguro

# Monitoreo (Telegram API)
TELEGRAM_BOT_TOKEN=token_de_tu_bot_aqui
TELEGRAM_CHAT_ID=id_del_chat_de_monitoreo

# Envío de Correos (SMTP)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=contrasena_smtp
SMTP_FROM="IECM Concurso Ensayo" <noreply@ejemplo.com>
SMTP_BCC=buzon_institucional@ejemplo.com

# Inicialización (Seeds)
SEED_SUPERADMIN_PASSWORD=contrasena_superadmin_desarrollo
