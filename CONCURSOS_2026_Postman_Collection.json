{
	"info": {
		"_postman_id": "c2026-api-collection-iecm",
		"name": "CONCURSOS 2026 - IECM API Collection",
		"description": "Colección completa de APIs de la plataforma Concurso 2026 / Hackatón IECM (Backend Express + SQL Server)",
